rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'scarlet@gmail.com' || request.auth.token.email == 'scarletshadow84@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Anime catalog rules
    match /anime/{animeId} {
      allow read: if true; // Public access for browsing
      allow write: if isAdmin(); // Only Admin can manage catalog
    }

    // 2. User Profile Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Create user profile - must be their own ID, and users cannot self-assign role to admin unless they match the admin email
      allow create: if isOwner(userId) 
        && incoming().id == userId 
        && (incoming().role != 'admin' || request.auth.token.email == 'scarlet@gmail.com' || request.auth.token.email == 'scarletshadow84@gmail.com');
      
      // Update user profile - immutable createdAt, and role can only be altered by admin or if keeping existing
      allow update: if isOwner(userId)
        && incoming().createdAt == existing().createdAt
        && (incoming().role == existing().role || isAdmin());
      
      allow delete: if isAdmin();
    }

    // 3. Watch History Rules
    match /history/{historyId} {
      // Allow user to get or list their own records only
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Create watch history item
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().progressSeconds is number
        && incoming().durationSeconds is number
        && incoming().completed is bool;

      // Update watch history item
      allow update: if isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().progressSeconds is number
        && incoming().durationSeconds is number
        && incoming().completed is bool;

      // Delete watch history item
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 4. Custom Subtitles Rules
    match /customSubtitles/{subtitleId} {
      allow read: if true; // Public access for video player playback
      allow write: if isAdmin(); // Only Admins can upload, modify, or delete custom subtitles
    }
  }
}
